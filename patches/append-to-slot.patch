From: Han Xiao <han.xiao@jina.ai>
Subject: [PATCH] Add append_to_slot for efficient multi-turn on cached KV

Adds `append_to_slot` parameter to /completion endpoint.
When true, query tokens are appended to the existing slot's cached
KV state instead of requiring the full prompt to be resent.

This enables:
- TTFT ~3.7s (vs ~6.3s with full prompt resend)
- Zero network transfer of 905K cached tokens
- Zero re-tokenization of the base document
- Correct multi-turn conversation on hybrid/recurrent models (Qwen3.5)

The implementation:
1. Adds `append_to_slot` bool to task_params (server-task.h/.cpp)
2. In server_slot, adds `n_input_total` and `append_tokens` vector
3. On SLOT_STATE_STARTED with append mode, constructs combined token
   sequence from slot.prompt.tokens (cached) + task.tokens (query)
4. Replaces all slot.task->n_tokens() references in the processing
   loop with slot.n_input_total for correct bounds checking
5. Uses a persistent append_tokens buffer to avoid reconstruction
   on each batch iteration (fixes crash with hybrid models)

Applied against: spiritbuun/llama-cpp-turboquant-cuda
Branch: feature/turboquant-kv-cache

---
diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index a49ddb594..91b88c98f 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -49,6 +49,7 @@ struct task_params {
     bool stream          = true;
     bool include_usage   = false;
     bool cache_prompt    = true; // remember the prompt to avoid reprocessing all prompt
+    bool append_to_slot  = false; // append query to existing slot cache
     bool return_tokens   = false;
     bool return_progress = false;
 
diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index 7d543b929..fda8882a0 100644
--- a/tools/server/server-task.cpp
+++ b/tools/server/server-task.cpp
@@ -261,6 +261,7 @@ task_params server_task::params_from_json_cmpl(
     params.include_usage    = json_value(stream_opt, "include_usage",      false);
     params.cache_prompt     = json_value(data,       "cache_prompt",       defaults.cache_prompt);
     params.return_tokens    = json_value(data,       "return_tokens",      false);
+    params.append_to_slot   = json_value(data,       "append_to_slot",     false);
     params.return_progress  = json_value(data,       "return_progress",    false);
 
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 0e0cb2c83..d168184e7 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -73,6 +73,8 @@ struct server_slot {
     int32_t n_remaining = -1;
     int32_t i_batch     = -1;
 
+    int32_t n_input_total = 0; // total input tokens (cached + query in append mode)
+    std::vector<llama_token> append_tokens; // combined tokens for append mode
     int32_t n_prompt_tokens_cache     = 0;
     int32_t n_prompt_tokens_processed = 0;

In the SLOT_STATE_STARTED block, before accessing input_tokens:

+    // append mode: build combined token sequence once
+    if (slot.state == SLOT_STATE_STARTED) {
+        if (slot.task->params.append_to_slot && slot.prompt.n_tokens() > 0) {
+            slot.n_input_total = slot.prompt.n_tokens() + slot.task->n_tokens();
+            slot.append_tokens.clear();
+            slot.append_tokens.reserve(slot.n_input_total);
+            const auto & cached = slot.prompt.tokens.get_text_tokens();
+            slot.append_tokens.insert(slot.append_tokens.end(), cached.begin(), cached.end());
+            const auto & query = slot.task->tokens.get_text_tokens();
+            slot.append_tokens.insert(slot.append_tokens.end(), query.begin(), query.end());
+        } else {
+            slot.n_input_total = slot.task->n_tokens();
+        }
+    }
+
+    // Use persistent combined buffer for append mode
+    std::unique_ptr<server_tokens> _append_buf;
+    if (slot.task->params.append_to_slot && !slot.append_tokens.empty()) {
+        _append_buf = std::make_unique<server_tokens>(slot.append_tokens, false);
+    }
+    const auto & input_tokens = _append_buf ? *_append_buf : slot.task->tokens;

Then replace ALL occurrences of slot.task->n_tokens() in the processing
loop (lines ~1200-2700) with slot.n_input_total (19 replacements total).
